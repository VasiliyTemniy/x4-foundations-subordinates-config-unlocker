<?xml version="1.0" encoding="utf-8"?>
<diff>
  <replace sel="/aiscript/init/do_if[@value='this.isplayerowned']/do_else">
    <do_else>
      <!-- VAS-SCU: keep player-edited station subordinate mining ranges.
           Mining basket controls are intentionally out of scope; vanilla already has
           its own mining-basket configuration path. -->
      <do_if value="not @player.entity.$vas_scu_unlock_miners">
        <do_if value="$maxbuy != $maxrange">
          <set_value name="$maxbuy" exact="$maxrange"/>
          <do_if value="@$thisorder.exists">
            <edit_order_param order="this.assignedcontrolled.order" param="'maxbuy'" value="$maxbuy"/>
          </do_if>
        </do_if>
      </do_if>
    </do_else>
  </replace>
</diff>
